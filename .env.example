# ---- General ----
PM_ENV=development
PM_LOG_LEVEL=INFO
PM_WORKSPACE_DIR=./.pm_workspaces
PM_ARCHIVE_DIR=./archive
PM_SECRET_KEY=change-this-long-random-admin-secret

# ---- HTTP server ----
PM_HTTP_HOST=0.0.0.0
PM_HTTP_PORT=8080

# ---- GitHub ----
PM_GITHUB_WEBHOOK_SECRET=change-me
PM_GITHUB_APP_TOKEN=ghp_xxx
PM_GITHUB_ALLOWED_REPOS=acme/payments,acme/checkout
PM_GITHUB_TRIGGER_LABEL=patch-machine

# ---- Discord ----
PM_DISCORD_BOT_TOKEN=
PM_DISCORD_GUILD_ALLOWLIST=
PM_DISCORD_CHANNEL_MAP_PATH=./config/channel_map.yml

# ---- LLM ----
PM_LLM_DEFAULT_ROUTE=cloud
PM_LLM_PROVIDER=openai
PM_OPENAI_API_KEY=sk-...
PM_OPENAI_MODEL=gpt-4o-mini
PM_OPENAI_BASE_URL=
PM_ANTHROPIC_API_KEY=
PM_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
PM_GEMINI_API_KEY=
PM_GEMINI_MODEL=gemini-1.5-flash
PM_VLLM_BASE_URL=http://localhost:8000/v1
PM_VLLM_MODEL=Qwen/Qwen3-4B
# embedded = vLLM이 FastAPI와 같은 프로세스에서 GPU로 직접 로드 (권장).
# http     = 외부 OpenAI 호환 vLLM 서버에 PM_VLLM_BASE_URL 로 붙음.
PM_VLLM_MODE=embedded
PM_VLLM_DTYPE=bfloat16
PM_VLLM_MAX_MODEL_LEN=8192
PM_VLLM_GPU_MEMORY_UTILIZATION=0.9
PM_VLLM_ENFORCE_EAGER=false
PM_VLLM_TRUST_REMOTE_CODE=true
PM_LOCAL_LLM_BASE_URL=http://localhost:8000/v1

# ---- Agent graph ----
PM_MAX_SELF_CORRECTION=2
PM_EVENT_QUEUE_SIZE=100
